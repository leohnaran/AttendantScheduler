{
  "name": "attendant-scheduler",
  "description": "Attendant Scheduler for Jehovah's Witnesses Circuit Assemblies and Regional Conventions",
  "author": "leohnaran",
  "private": true,
  "version": "3.6.8",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/leohnaran/AttendantScheduler.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:nocache": "npm run build && cp dist/index.html schedule.html",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.cameron.attendantscheduler",
    "productName": "Attendant Scheduler",
    "publish": [
      {
        "provider": "github",
        "owner": "leohnaran",
        "repo": "AttendantScheduler"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "electron-updater": "^6.8.3",
    "html-to-image": "^1.11.13",
    "node-machine-id": "^1.1.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "vite": "^5.0.0",
    "vite-plugin-singlefile": "^0.13.5",
    "wait-on": "^9.0.4"
  }
}
